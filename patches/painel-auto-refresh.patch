     return () => {
       ativo = false;
       window.clearTimeout(agendamentoPerfil);
       window.removeEventListener("guarani:perfil-change", sincronizarPerfilLocal);
       window.removeEventListener("guarani:permissions-change", sincronizarPerfilLocal);
